{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null && (data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid || !data.exists())",
        "host": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "guest": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && root.child('rooms/' + $code + '/host').exists()"
        },
        "status": {
          ".write": "auth != null && (root.child('rooms/' + $code + '/host').val() === auth.uid || root.child('rooms/' + $code + '/guest').val() === auth.uid)"
        },
        "msgs": {
          "host": {
            ".write": "auth != null && root.child('rooms/' + $code + '/host').val() === auth.uid"
          },
          "guest": {
            ".write": "auth != null && root.child('rooms/' + $code + '/guest').val() === auth.uid"
          }
        },
        "presence": {
          "host": {
            ".write": "auth != null && root.child('rooms/' + $code + '/host').val() === auth.uid"
          },
          "guest": {
            ".write": "auth != null && root.child('rooms/' + $code + '/guest').val() === auth.uid"
          }
        }
      }
    }
  }
}
